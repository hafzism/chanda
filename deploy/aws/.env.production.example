# Copy to .env.production on the EC2 host, set mode 0600, and never commit it.
APP_DOMAIN=support.example.com
AWS_REGION=ap-south-1
CLOUDWATCH_LOG_GROUP=replace-with-cloudformation-log-group-output
SUPPLINE_IMAGE=suppline-ai:production

# PostgreSQL and Redis stay on Docker's private backend network.
POSTGRES_DB=suppline
POSTGRES_USER=suppline
# Use base64url-safe values so they can be embedded in internal connection URLs.
POSTGRES_PASSWORD=replace_with_a_long_base64url_safe_password
REDIS_PASSWORD=replace_with_a_different_base64url_safe_password

# S3 uses the EC2 instance role; do not add long-lived AWS access keys here.
S3_BUCKET=replace-with-private-bucket-name

# Firebase browser configuration (public by design).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin configuration.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

GEMINI_API_KEY=
CHANNEL_CREDENTIALS_ENCRYPTION_KEY=

GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=

META_GRAPH_API_VERSION=v24.0

STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_PRO_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
