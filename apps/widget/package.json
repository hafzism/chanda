{
  "name": "@suppline/widget",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --format=iife --global-name=SupplineWidget --minify --outfile=dist/widget.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "vitest": "4.1.1"
  }
}
