NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_WIDGET_API_ORIGIN=http://localhost:4000
WEB_APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://suppline:suppline@localhost:55432/suppline
REDIS_URL=redis://localhost:56379
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=suppline-local
S3_ACCESS_KEY=suppline
S3_SECRET_KEY=change-this-local-secret

# Firebase client configuration (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service-account configuration (API only; never expose these)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Server-side AI credential used for knowledge embeddings and grounded drafts
GEMINI_API_KEY=
CHANNEL_CREDENTIALS_ENCRYPTION_KEY=
TELEGRAM_WEBHOOK_BASE_URL=https://api.example.com

# Google OAuth web client used for Gmail mailbox access (API only)
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:4000/v1/public/gmail/oauth/callback

# Meta WhatsApp Cloud API test/development configuration
META_GRAPH_API_VERSION=v24.0
WHATSAPP_WEBHOOK_BASE_URL=https://api.example.com
META_MESSAGING_WEBHOOK_BASE_URL=https://api.example.com

# Stripe test mode. Create one recurring Pro price and configure the Customer Portal.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRO_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
WEB_APP_URL=http://localhost:3000
