NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000
DATABASE_URL=postgresql://suppline:suppline@localhost:55432/suppline
REDIS_URL=redis://localhost:56379
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=suppline-local
S3_ACCESS_KEY=suppline
S3_SECRET_KEY=change-this-local-secret

# Firebase client configuration (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service-account configuration (API only; never expose these)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
